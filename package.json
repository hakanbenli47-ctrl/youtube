{
  "name": "youtube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n WEB,SYNC -c magenta,cyan \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev",
    "dev:worker": "node scripts/sync-worker.mjs",
    "build": "next build",
    "start": "concurrently -k -n WEB,SYNC -c magenta,cyan \"npm:start:web\" \"npm:start:worker\"",
    "start:web": "next start",
    "start:worker": "node scripts/sync-worker.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "csv-parse": "^7.0.1",
    "date-fns": "^4.4.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
